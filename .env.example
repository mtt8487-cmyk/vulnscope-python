# The scanner defaults to loopback only. Optional: set exact private IPs
# you own or have written authorization for. DO NOT commit private host data.
# PowerShell example: $env:VULNSCOPE_ALLOWED_TARGETS="192.168.1.50"
VULNSCOPE_ALLOWED_TARGETS=
# On deployments, use public_app.py; setting this also disables app.py live mode.
VULNSCOPE_PUBLIC_DEMO=1
